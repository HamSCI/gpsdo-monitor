[Unit]
Description=Leo Bodnar GPSDO Monitor
Documentation=https://github.com/HamSCI/gpsdo-monitor
After=systemd-udev-settle.service
Wants=systemd-udev-settle.service

[Service]
Type=simple
User=gpsdo
Group=gpsdo
# SupplementaryGroups=dialout
ExecStart=/usr/local/bin/gpsdo-monitor serve
Restart=on-failure
RestartSec=5
RuntimeDirectory=gpsdo
RuntimeDirectoryMode=0755
# Hardening — the daemon needs HID (/dev/hidraw*) and optionally CDC
# (/dev/ttyACM*); everything else stays locked down.
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=false
# char-usb_device covers /dev/bus/usb/NNN/MMM (major 189). Needed
# because the python `hidapi` PyPI wheel is built against libusb and
# opens the USB-transport node rather than /dev/hidraw*.
DeviceAllow=char-usb_device rw
DeviceAllow=char-hidraw rw
DeviceAllow=char-ttyACM rw
NoNewPrivileges=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true

[Install]
WantedBy=multi-user.target
